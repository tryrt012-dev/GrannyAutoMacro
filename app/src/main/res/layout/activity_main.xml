<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A24"
            app:cardCornerRadius="20dp"
            app:strokeColor="#FF2A54"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRANNY AUTO-BOT"
                    android:textColor="#FF2A54"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practice Mode Macro Controller v1.0"
                    android:textColor="#8E8E9E"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#121218"
                    android:padding="12dp"
                    android:text="🟢 Status: Standby (Preset 1 Aktif)"
                    android:textColor="#00F59B"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pilihan Preset -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PILIH POLA ITEM (PRESET RNG)"
            android:textColor="#B0B0C0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button android:id="@+id/btnP1" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="P1" android:backgroundTint="#FF2A54" android:textColor="#FFFFFF" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnP2" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="P2" android:backgroundTint="#252533" android:textColor="#FFFFFF" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnP3" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="P3" android:backgroundTint="#252533" android:textColor="#FFFFFF" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnP4" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="P4" android:backgroundTint="#252533" android:textColor="#FFFFFF" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnP5" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="P5" android:backgroundTint="#252533" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Panel Kontrol -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A24"
            app:cardCornerRadius="20dp"
            app:strokeColor="#2A2A38"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KONTROL EKSEKUSI MACRO"
                    android:textColor="#B0B0C0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="🔴 MULAI REKAM RUTE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E6194B"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="▶️ AUTO-PLAY TAMATKAN"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#00C875"
                    android:textColor="#0D0D12"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="⏹️ HENTIKAN PROSES"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#323246"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
