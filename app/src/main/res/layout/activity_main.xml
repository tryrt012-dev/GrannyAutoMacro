<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#161622"
            app:cardCornerRadius="22dp"
            app:strokeColor="#FF2A54"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👵 GRANNY AUTOBOT v2.1"
                    android:textColor="#FF2A54"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fixed Native Macro &amp; Accessibility Hub"
                    android:textColor="#9E9EAE"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

                <!-- TOMBOL PINTASAN BARU -->
                <Button
                    android:id="@+id/btnOpenAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="⚙️ 1. BUKA PENGATURAN AKSESIBILITAS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnLaunchOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:text="🚀 2. MUNCULKAN PANEL OVERLAY"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#00E676"
                    android:textColor="#0B0B10"/>

                <Button
                    android:id="@+id/btnStopOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="❌ MATIKAN OVERLAY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2A2A3C"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
